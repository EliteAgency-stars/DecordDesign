# Correos (Resend). Sin RESEND_API_KEY los leads se guardan igual en Supabase, sin correo.
# Con el remitente de prueba (onboarding@resend.dev) Resend solo entrega al dueño de la cuenta:
# verifica el dominio decordesign.com.co en Resend y usa, por ejemplo, RESEND_FROM="Decord Design <hola@decordesign.com.co>".
RESEND_API_KEY=
RESEND_FROM=
LEADS_EMAIL=decordesign1sas@gmail.com

# Cloudflare Turnstile (opcional). Sin las dos llaves quedan el honeypot y el límite por IP.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase: por defecto el proyecto compartido «proyectumia» (tabla decord_leads, bucket decord-maquetas).
SUPABASE_URL=
SUPABASE_ANON_KEY=
